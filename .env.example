# Copia este archivo a .env y llena los valores. .env NO se versiona.

# --- Base de datos ---
# Usa una base propia dentro del cluster; apuntarla a la de otro proyecto
# haría que "npm run db:seed" borrara sus colecciones.
DATABASE_URL="mongodb+srv://usuario:contrasena@cluster.mongodb.net/anuies-stem?retryWrites=true&w=majority"

# --- Sesión ---
AUTH_SECRET="genera uno con: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
EDICION="2026"

# --- Almacenamiento: AWS S3 ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
# Prefijo dentro del bucket, para no mezclar con otros proyectos.
S3_PREFIJO="anuies-stem/2026"
# Vigencia en minutos de las URLs firmadas de lectura.
S3_URL_MINUTOS="5"

# --- Evaluación por IA ---
OPENAI_API_KEY=""
OPENAI_MODELO="gpt-4o-mini"
# Con 0 la IA evalúa sobre la propuesta escrita y lo declara en la
# justificación del criterio de video. Con 1 se espera que un trabajo aparte
# haya llenado la transcripción del video.
TRANSCRIPCION_ACTIVA="0"

# --- Correo (SMTP de Gmail: usa una contraseña de aplicación) ---
EMAIL_USER=""
EMAIL_PASS=""
CORREO_REMITENTE="Reto ANUIES4MX <no-reply@ejemplo.mx>"
# Base para los enlaces de los correos. En Vercel, la URL del despliegue.
FRONTEND_URL="http://localhost:3000"
